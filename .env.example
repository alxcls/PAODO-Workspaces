OPENAI_API_KEY=sk-...
OPENAI_model=gpt-5.1-codex-mini

# Basic Auth — required for agent isolation in networked/multi-user deployments.
# When set, all HTTP requests (including API routes) must supply these credentials.
# Browsers cache them after the first challenge; Docker containers are blocked.
# Leave both empty to disable auth (local dev only).
USERNAME=
PASSWORD=

# Public URL of the app (e.g. https://yourapp.com). Used to scope the
# Access-Control-Allow-Origin header on workspace file serving. Leave empty in local dev.
APP_URL=

# Log level for pino. One of: trace, debug, info, warn, error, fatal.
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=debug