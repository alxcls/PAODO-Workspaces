# LLM PROVIDER API KEYS ARE NOT SET HERE. Enter them in the running app, under the gear icon →
# Settings → Provider API keys. They are stored encrypted on the data volume, so a deployment can be
# handed over, backed up, or copied without carrying its keys along in a text file.
# The server starts with no keys at all. A workspace whose provider has none stops at the start of
# its conversation and says which provider needs one.
# Provider, model, and reasoning effort are chosen per workspace in the UI (Model block). A workspace
# that hasn't picked runs the first available provider's first model — provider order is the registry
# in lib/agent/buildModel.ts, model order is lib/models/registry.ts (each list is cheapest first).

# Which providers this deployment offers, in the workspace Model picker and in GET /api/models.
# Unset means available, so leaving these out offers everything the app supports. Only the exact
# value `false` disables a provider; anything else leaves it offered.
#
# SETTING ONE TO false DELETES THAT PROVIDER'S STORED API KEY at the next startup, and switching it
# back on does NOT bring the key back — it has to be entered again. That is deliberate: it is what
# makes the switch mean "nobody can spend on this" rather than only "hidden from the picker". A
# workspace already set to a withdrawn provider stops at the start of its conversation, and the key
# cannot be re-entered while the provider stays switched off.
#
# Switching every provider off is allowed and the server still starts; no workspace can run until one
# is switched back on.
OPENAI_AVAILABLE=true
ANTHROPIC_AVAILABLE=true
DEEPSEEK_AVAILABLE=true
MOONSHOT_AVAILABLE=true
MISTRAL_AVAILABLE=true

# Anthropic 1-hour prompt cache TTL (opt-in). Leave unset for the default cache behavior.

# ANTHROPIC_CACHE_TTL_1H=true

# Basic Auth
# All HTTP requests (including API routes) must supply these credentials.
# Browsers cache them after the first challenge; agent containers cannot authenticate (credentials are never passed to docker run).
USERNAME=USERNAME
PASSWORD=PASSWORD

# Port the server listens on. Default: 3000.
PORT=3000

# Optional direct-public API/MCP gateway. Set these only when running
# docker-compose.workspace-api.yml; leave both unset when no public
# programmatic gateway is required.
# WORKSPACE_API_DOMAIN=
# WORKSPACE_API_BIND_IP=
# Use your own public API hostname and your VPS's public IPv4 address.

# Log level for pino. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Multi-agent network graph (call_agent + list_agents tools, /graph UI, /api/workspace-graph).
# On by default; set to false to disable agent-to-agent calls entirely.
GRAPH_ENABLED=true

# Emergency instance-wide ceiling for simultaneously active agent runs. Direct chat/API/scheduled
# runs and nested agent-to-agent/MCP runs all count. The next request is rejected immediately (not
# queued) and may be retried after another run finishes. Default: 10.
MAX_CONCURRENT_AGENT_RUNS=10

# PAODO app-container limits. These cap the control plane that owns conversations, agent streams,
# schedules, and agent-to-agent orchestration. Reapply with `docker compose up -d` after changing.
APP_MEMORY_LIMIT=2g
APP_CPUS=2.0

# Structured skill call retry caps (agent-to-agent calls via call_agent).
# SKILL_INPUT_MAX_RETRIES: consecutive input-schema failures for the same (callee, skill)
#   before call_agent returns a terminal error telling the caller to stop retrying. Default: 2.
# SKILL_OUTPUT_MAX_RETRIES: output-schema correction passes (error fed back into the callee's
#   conversation, callee re-run) before a call fails with OUTPUT_VALIDATION_ERROR. Default: 2.
# SKILL_NEEDS_INPUT_MAX_ROUNDS: how many times a callee may reply with a NEEDS_INPUT question
#   for the same (callee, skill) before the caller is told to stop re-calling. Default: 2.
SKILL_INPUT_MAX_RETRIES=2
SKILL_OUTPUT_MAX_RETRIES=2
SKILL_NEEDS_INPUT_MAX_ROUNDS=2

# Per-workspace container resource limits. These apply when a workspace container is first created;
# existing containers keep their current limits until explicitly resized with `docker update`.
# Each active workspace gets its own Docker container capped at these values.
# These are the values applied to NEWLY created containers. To rescale a workspace that already
# exists, tune its cgroup live — no restart, no rebuild, installed packages untouched:
#   docker update -m 4g --memory-swap 8g --cpus 2 --pids-limit 1024 ws_<workspaceId>
# Tune based on how many concurrent workspaces your host can support:
# e.g. a 8 GB host with CONTAINER_MEMORY=1g can safely run ~6 concurrent workspaces.
CONTAINER_MEMORY=1g
CONTAINER_CPUS=1.0
# CONTAINER_PIDS_LIMIT: max processes AND threads per workspace container. Without it, a fork bomb in
# one workspace exhausts the host's PIDs and takes down every workspace plus the app. 512 is roomy for
# normal work (npm install, a dev server, a build); raise it for thread-heavy stacks — a JVM, a
# Playwright/browser grid, or a wide `make -j` can hold hundreds of threads on its own. Too low shows
# up inside the container as "fork: Resource temporarily unavailable", not as a clear error message.
CONTAINER_PIDS_LIMIT=512

# Idle timeout before a workspace container is stopped (milliseconds). Default: 10 minutes.
CONTAINER_IDLE_MS=600000

# Agent shell command timeouts.
# EXEC_SILENCE_TIMEOUT_MS: kills a command if it produces no output for this long. Default: 5 minutes.
# EXEC_MAX_TIMEOUT_MS: kills a command after this total elapsed time, even if it is still producing output. Default: 30 minutes.
EXEC_SILENCE_TIMEOUT_MS=300000
EXEC_MAX_TIMEOUT_MS=1800000
