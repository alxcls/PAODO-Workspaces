# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Reasoning effort level — applies to both providers (default: low).
# OpenAI: maps directly to effort (low | medium | high).
# Anthropic: translates to thinking budget_tokens (low=4000 / medium=10000 / high=20000).
REASONING_EFFORT=low

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Basic Auth
# All HTTP requests (including API routes) must supply these credentials.
# Browsers cache them after the first challenge; agent containers cannot authenticate (credentials are never passed to docker run).
USERNAME=
PASSWORD=

# Port the server listens on. Default: 3000.
PORT=3000

# Log level for pino. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=

# Enable multi-agent network graph (call_agent + list_agents tools, /graph UI, /api/workspace-graph)
GRAPH_ENABLED=false

# Per-workspace container resource limits.
# Each active workspace gets its own Docker container capped at these values.
# Tune based on how many concurrent workspaces your host can support:
# e.g. a 8 GB host with CONTAINER_MEMORY=1g can safely run ~6 concurrent workspaces.
CONTAINER_MEMORY=1g
CONTAINER_CPUS=1.0

# Idle timeout before a workspace container is stopped (milliseconds). Default: 10 minutes.
CONTAINER_IDLE_MS=600000

# Agent shell command timeouts.
# EXEC_SILENCE_TIMEOUT_MS: kills a command if it produces no output for this long. Default: 60 seconds.
# EXEC_MAX_TIMEOUT_MS: kills a command after this total elapsed time, even if it is still producing output. Default: 30 minutes.
EXEC_SILENCE_TIMEOUT_MS=60000
EXEC_MAX_TIMEOUT_MS=1800000