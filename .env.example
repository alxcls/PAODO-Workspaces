# LLM provider API keys. Set the key(s) for whichever providers you want available.
# The provider, model, and reasoning effort are NOT set here anymore — they are chosen per
# workspace in the UI (Model block). A workspace that hasn't picked defaults to deepseek-v4-pro.
# Refresh the model/pricing catalog with `npm run update-pricing`.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# Anthropic 1-hour prompt cache TTL (opt-in). Leave unset for the default cache behavior.
# ANTHROPIC_CACHE_TTL_1H=true

# Basic Auth
# All HTTP requests (including API routes) must supply these credentials.
# Browsers cache them after the first challenge; agent containers cannot authenticate (credentials are never passed to docker run).
USERNAME=USERNAME
PASSWORD=PASSWORD

# Port the server listens on. Default: 3000.
PORT=3000

# Log level for pino. One of: trace, debug, info, warn, error, fatal.
LOG_LEVEL=debug

# Multi-agent network graph (call_agent + list_agents tools, /graph UI, /api/workspace-graph).
# On by default; set to false to disable agent-to-agent calls entirely.
GRAPH_ENABLED=true

# Structured skill call retry caps (agent-to-agent calls via call_agent).
# SKILL_INPUT_MAX_RETRIES: consecutive input-schema failures for the same (callee, skill)
#   before call_agent returns a terminal error telling the caller to stop retrying. Default: 2.
# SKILL_OUTPUT_MAX_RETRIES: output-schema correction passes (error fed back into the callee's
#   conversation, callee re-run) before a call fails with OUTPUT_VALIDATION_ERROR. Default: 2.
# SKILL_NEEDS_INPUT_MAX_ROUNDS: how many times a callee may reply with a NEEDS_INPUT question
#   for the same (callee, skill) before the caller is told to stop re-calling. Default: 2.
SKILL_INPUT_MAX_RETRIES=2
SKILL_OUTPUT_MAX_RETRIES=2
SKILL_NEEDS_INPUT_MAX_ROUNDS=2

# Per-workspace container resource limits.
# Each active workspace gets its own Docker container capped at these values.
# Tune based on how many concurrent workspaces your host can support:
# e.g. a 8 GB host with CONTAINER_MEMORY=1g can safely run ~6 concurrent workspaces.
CONTAINER_MEMORY=1g
CONTAINER_CPUS=1.0

# Idle timeout before a workspace container is stopped (milliseconds). Default: 10 minutes.
CONTAINER_IDLE_MS=600000

# Agent shell command timeouts.
# EXEC_SILENCE_TIMEOUT_MS: kills a command if it produces no output for this long. Default: 60 seconds.
# EXEC_MAX_TIMEOUT_MS: kills a command after this total elapsed time, even if it is still producing output. Default: 30 minutes.
EXEC_SILENCE_TIMEOUT_MS=60000
EXEC_MAX_TIMEOUT_MS=1800000

