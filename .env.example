# Copy to .env. USERNAME and PASSWORD are the only required values — every other variable
# below has a working default and is shown commented out at that default.
#
# LLM provider API keys are NOT set here. Enter them in the running app under the gear icon →
# Settings → Provider API keys. Capacity tuning and deployment steps: deploy/README.md.

# Basic Auth for the UI and API. The server refuses to start without both.
USERNAME=USERNAME
PASSWORD=PASSWORD

# Public UI hostnames, comma-separated. REQUIRED behind a reverse proxy or tunnel: only
# localhost, 127.0.0.1, ::1 and WORKSPACE_API_DOMAIN are trusted by default, and any other
# Host is rejected with 421 before authentication.
# PAODO_TRUSTED_HOSTS=workspaces.example.com

# Public API/MCP gateway. Both are required by docker-compose.workspace-api.yml and unused
# without it.
# WORKSPACE_API_DOMAIN=api.example.com
# WORKSPACE_API_BIND_IP=203.0.113.10

# Provider availability. Setting one to false is DESTRUCTIVE: that provider's stored API key
# is deleted at the next startup and must be entered again. Unset means available.
# OPENAI_AVAILABLE=false
# ANTHROPIC_AVAILABLE=false
# DEEPSEEK_AVAILABLE=false
# MOONSHOT_AVAILABLE=false
# MISTRAL_AVAILABLE=false

# Capacity and container limits — see deploy/README.md before changing.
# MAX_CONCURRENT_AGENT_RUNS=10
# APP_MEMORY_LIMIT=2g
# APP_CPUS=2.0
# CONTAINER_MEMORY=1g
# CONTAINER_CPUS=1.0
# CONTAINER_PIDS_LIMIT=512
# CONTAINER_IDLE_MS=600000

# Agent shell command timeouts: no output for this long, and total elapsed.
# EXEC_SILENCE_TIMEOUT_MS=300000
# EXEC_MAX_TIMEOUT_MS=1800000

# Retry caps for structured agent-to-agent calls (call_agent).
# SKILL_INPUT_MAX_RETRIES=2
# SKILL_OUTPUT_MAX_RETRIES=2
# SKILL_NEEDS_INPUT_MAX_ROUNDS=2

# PORT=3000
# LOG_LEVEL=info
# GRAPH_ENABLED=false            # disables agent-to-agent calls and the /graph UI
# ANTHROPIC_CACHE_TTL_1H=true    # opt into Anthropic's 1-hour prompt cache
