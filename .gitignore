# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (local dev only)
/e2e/
playwright.config.ts
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.ruff_cache
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# restic repo password — unlocks the offsite backups, never commit
/restic-password

# transient staging the offsite script builds the set into before restic reads it
/.backup-staging

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data. Deployed state lives on the named volumes; this only appears if a script runs
# outside compose and hits the cwd fallback in lib/infra/paths.ts.
/data/
/.data-backup
/.paodo-provider-vault/
/.paodo-provider-key/
/.paodo-workspace-secret-vault/
/.paodo-workspace-secret-key/
# Legacy greenfield artifacts are not read or migrated, but may still contain credentials locally.
/.paodo-secret-vault/
/.paodo-secret-key/

# captured production logs — contain client IPs, never commit
/logs/

# local database inspection — contains conversation and execution plaintext, never commit
/db/

# generated codebase graph
graph.html

# Claude Code skills (local tooling, not for version control)
/.claude/skills/

# Claude project instructions (local only)
CLAUDE.md

# Operator notes for our own deployment — the repo stays IAP-agnostic
*.local.md

# Experimental CLI client — developed locally until it moves to its own repository
/cli/

# Local operator tool for provisioning S3 buckets — touches live infra, stays local
/scripts/commission-s3-bucket.ts
