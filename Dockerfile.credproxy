# Build the credential proxy into one JavaScript entry point from its own tiny dependency manifest;
# neither this stage nor the final image installs Next.js, provider SDKs, Docker tooling,
# application routes, or provider-vault code.
FROM node:22-trixie-slim AS builder
WORKDIR /src
RUN npm install -g npm@11.6.2
COPY credproxy/package*.json ./
RUN npm ci
COPY proxyEntry.ts ./
COPY lib/ ./lib/
RUN npx --no-install esbuild proxyEntry.ts \
    --bundle \
    --platform=node \
    --target=node22 \
    --format=cjs \
    --external:pino \
    --external:node-forge \
    --outfile=/dist/proxyEntry.cjs

# Install only production modules in a disposable stage. The final image has no package manager.
FROM node:22-trixie-slim AS runtime-deps
WORKDIR /runtime
COPY credproxy/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Shell-less runtime: Node, one bundled entry point, and the two explicit external packages. All
# mutable state arrives through Compose's three read-only mounts; only /tmp is a small tmpfs.
FROM gcr.io/distroless/nodejs22-debian12:nonroot AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=runtime-deps --chown=1000:1000 /runtime/node_modules ./node_modules
COPY --from=builder --chown=1000:1000 /dist/proxyEntry.cjs ./proxyEntry.cjs
# The app image's `node` account is UID/GID 1000 and creates the mounted key as mode 0600. Use the
# same numeric non-root identity here so read-only sharing does not require weakening key permissions.
USER 1000:1000
EXPOSE 9998
CMD ["proxyEntry.cjs"]
