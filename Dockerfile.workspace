FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_ROOT_USER_ACTION=ignore

RUN apt-get update && apt-get install -y \
    bash curl wget git jq build-essential \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    libffi-dev liblzma-dev ca-certificates \
    python3 python3-pip python3-venv \
    ripgrep fd-find tree unzip zip nano vim procps && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3 /usr/bin/python

# Three execution identities (see doc/adr/accepted/agent-privilege-model.md):
#   developer (UID 1001) — the agent's normal, NON-ROOT identity. `execute_command` runs as this
#                          user, so it physically cannot read root-owned secrets or write root-owned
#                          (locked) files. Owns nvm/pyenv/asdf install dirs and all unlocked workspace files.
#   agent     (UID 999)  — even more restricted; used when the workspace is globally locked.
#   root                 — server-only privileged path: runs privileged scripts and applies locks via
#                          `docker exec -u root`, which the agent can never compose.
# NOTE: UID 1001 (not 1000) avoids colliding with the default `ubuntu` user ubuntu:24.04 ships at 1000.
RUN groupadd -g 999 agentgroup && \
    useradd -r -u 999 -g agentgroup -M -s /bin/bash agent && \
    useradd -u 1001 -m -s /bin/bash developer

# nvm + Node LTS — installed as developer so only developer (and root) can write to the install dirs.
# chmod -R 755 makes nvm dirs world-readable/executable so the agent user can execute node/npm.
# Symlinking real binaries (not the nvm script wrapper) into /usr/local/bin so they work in any shell
# without sourcing nvm.sh, and so the agent user can follow the symlink without needing /root access.
ENV NVM_DIR=/home/developer/.nvm
RUN su - developer -c "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash" && \
    su - developer -c ". $NVM_DIR/nvm.sh && nvm install --lts && nvm alias default node" && \
    chmod -R 755 /home/developer/.nvm && \
    NVM_BIN=$(su - developer -c ". $NVM_DIR/nvm.sh && dirname \$(which node)") && \
    ln -sf "$NVM_BIN/node" /usr/local/bin/node && \
    ln -sf "$NVM_BIN/npm"  /usr/local/bin/npm  && \
    ln -sf "$NVM_BIN/npx"  /usr/local/bin/npx

# pyenv — same ownership pattern: developer owns, chmod 755 lets agent read/execute but not write.
ENV PYENV_ROOT=/home/developer/.pyenv
ENV PATH=$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH
RUN git clone --depth=1 https://github.com/pyenv/pyenv.git $PYENV_ROOT && \
    cd $PYENV_ROOT && src/configure && make -C src && \
    chown -R developer:developer $PYENV_ROOT && \
    chmod -R 755 $PYENV_ROOT

# asdf — userspace version manager so the non-root `developer` can install languages
# (go, ruby, node, ...) without apt/root. Installed as developer; cloned to its home.
ENV ASDF_DIR=/home/developer/.asdf
RUN su - developer -c "git clone --depth=1 https://github.com/asdf-vm/asdf.git $ASDF_DIR --branch v0.14.1" && \
    chmod -R 755 $ASDF_DIR

# Make userspace tool dirs resolvable in every (login and non-login) shell for the developer user:
#   ~/.local/bin  — pip install --user console scripts
#   asdf shims    — asdf-managed language binaries
RUN printf '%s\n' \
    'export PATH=$HOME/.local/bin:$PATH' \
    '. /home/developer/.asdf/asdf.sh 2>/dev/null || true' \
    > /etc/profile.d/developer-userspace.sh && chmod 644 /etc/profile.d/developer-userspace.sh

WORKDIR /workspace
