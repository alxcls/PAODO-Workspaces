FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_ROOT_USER_ACTION=ignore

RUN apt-get update && apt-get install -y \
    bash curl wget git jq build-essential \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    libffi-dev liblzma-dev ca-certificates \
    python3 python3-pip python3-venv \
    ripgrep fd-find tree unzip zip nano vim procps && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3 /usr/bin/python

# GitHub CLI, from GitHub's official apt repo (the Ubuntu universe package lags). The agent reaches
# for `gh` for repo/PR/issue operations (GitHub API), which plain git cannot do. gh is a Go binary
# that already honors HTTPS_PROXY and SSL_CERT_FILE — both set by the container runtime — so it
# routes through the credential proxy and trusts its MITM cert with no extra config.
RUN mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Static, name-agnostic git credential helper for github.com only. It emits x-access-token:$GH_TOKEN
# at runtime — where GH_TOKEN is the opaque proxy token the app injects for the github.com-scoped
# secret — so `git clone/push/pull https://github.com/...` authenticates with no token in the URL,
# exactly like a `gh auth login`'d dev machine. Scoped to github.com so it never fires for other
# hosts, and emits nothing when GH_TOKEN is unset (git then falls back to its normal behaviour).
RUN git config --system credential.https://github.com.helper \
    '!f() { test "$1" = get && test -n "$GH_TOKEN" && printf "username=x-access-token\npassword=%s\n" "$GH_TOKEN"; }; f'

# Generic default commit identity so a fresh clone's first commit never fails with "Author identity
# unknown". Set at --system level, so it is only a fallback: any repo-level `git config user.name/
# user.email` (which the agent or user can set to their real GitHub account) overrides it. Kept
# account-agnostic on purpose — the image is shared across workspaces and doesn't know which GitHub
# account a given workspace authenticates as.
RUN git config --system user.name "PAODO Agent" && \
    git config --system user.email "agent@paodo.local"

# Force git to send proxy Basic auth preemptively. git defaults to http.proxyAuthMethod "anyauth",
# which withholds Proxy-Authorization on the CONNECT until the proxy issues a 407. The credential
# proxy never challenges (missing auth just tunnels), so an anyauth git never identifies its
# workspace, gets no injection rules, and its HTTPS is tunneled untouched — the opaque token then
# reaches github.com and is rejected ("Invalid username or token"). "basic" makes git send the
# credentials up front like curl does, so the proxy can MITM and substitute. Image-wide constant.
RUN git config --system http.proxyAuthMethod basic

# Single non-root runtime identity: `dev` at UID 1000 — the SAME uid as the app server's `node`
# user, so files created by the agent on the shared workspace volume are owned 1000:1000 and the
# app can read/write/delete them with no chown. The agent runs as this user for everything; it
# cannot touch /root, /etc, or system files. ubuntu:24.04 ships a default `ubuntu` user at uid 1000,
# so remove it first to free the uid.
RUN userdel -r ubuntu 2>/dev/null || true && \
    groupadd -g 1000 dev && \
    useradd -u 1000 -g 1000 -m -s /bin/bash dev

# System-package installs are NOT available from the agent's shell (it is non-root, and there is no
# setuid sudo — `no-new-privileges` would disable it anyway). The `apt_install` agent tool installs
# packages by running apt-get via `docker exec -u 0` from the app server, which controls Docker.

# nvm + Node 22 — installed as `dev`, who owns the install dirs and can therefore add Node versions
# at runtime. Real binaries (not the nvm wrapper) are symlinked into /usr/local/bin so node/npm/npx
# resolve in any shell without sourcing nvm.sh.
ENV NVM_DIR=/home/dev/.nvm
RUN su - dev -c "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash" && \
    su - dev -c ". $NVM_DIR/nvm.sh && nvm install 22 && nvm alias default 22" && \
    NVM_BIN=$(su - dev -c ". $NVM_DIR/nvm.sh && dirname \$(which node)") && \
    ln -sf "$NVM_BIN/node" /usr/local/bin/node && \
    ln -sf "$NVM_BIN/npm"  /usr/local/bin/npm  && \
    ln -sf "$NVM_BIN/npx"  /usr/local/bin/npx

# pyenv — owned by `dev`, who can install Python versions at runtime.
ENV PYENV_ROOT=/home/dev/.pyenv
ENV PATH=$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH
RUN git clone --depth=1 https://github.com/pyenv/pyenv.git $PYENV_ROOT && \
    cd $PYENV_ROOT && src/configure && make -C src && \
    chown -R dev:dev $PYENV_ROOT

RUN mkdir -p /workspace && chown dev:dev /workspace
WORKDIR /workspace
USER dev
