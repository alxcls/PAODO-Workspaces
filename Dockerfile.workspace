FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_ROOT_USER_ACTION=ignore
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y \
    bash curl wget git jq build-essential \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    libffi-dev liblzma-dev ca-certificates \
    python3 python3-pip python3-venv \
    ripgrep fd-find tree unzip zip nano vim procps && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3 /usr/bin/python

# Three execution identities (ADR: permission-model-three-identity-uid):
#   agent     (UID 999)  — restricted; sandboxed by OS permissions (other bits on all files).
#   privd     (UID 998)  — privileged; owns locked files and runs keyed scripts via server dispatch.
#   appuser   (UID 1002) — proxy for UI editor writes; only group membership (access) matters.
#   developer (UID 1001) — owns nvm/pyenv install dirs (toolchain only, not a workspace identity).
#
# access (GID 1001) — shared group for uid 1000 and uid 998; uid 999 is NOT a member.
# This lets app user and privd share file access via group bits without conflating their identities.
RUN groupadd -g 999 agentgroup && \
    groupadd -g 1001 access && \
    useradd -r -u 999 -g agentgroup -M -s /bin/bash agent && \
    useradd -r -u 998 -g access -M -s /bin/bash privd && \
    useradd -u 1001 -m -s /bin/bash developer

# Ensure the restricted agent user has a home directory so pip user installs work.
RUN mkdir -p /home/agent && chown agent:agentgroup /home/agent && chmod 755 /home/agent

# appuser (UID 1002) — proxy identity for UI editor writes inside the workspace container.
# UID 1000 is reserved by ubuntu:24.04's built-in 'ubuntu' user; 1002 is the next free UID.
# The specific UID doesn't matter — only group membership (access, GID 1001) is load-bearing.
# Belongs to access so it can read/write Normal files and read (but not write) Locked files.
RUN useradd -u 1002 -g access -M -s /bin/bash appuser

# nvm + Node LTS — installed as developer (build-time owner for toolchain setup only).
# Runtime binaries are copied to /opt/node and symlinked into /usr/local/bin so agent execution does
# not depend on traversing /home/developer permissions.
ENV NVM_DIR=/home/developer/.nvm
RUN su - developer -c "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash" && \
    su - developer -c ". $NVM_DIR/nvm.sh && nvm install --lts && nvm alias default node" && \
    chmod -R 755 /home/developer/.nvm && \
    NVM_BIN=$(su - developer -c ". $NVM_DIR/nvm.sh && dirname \$(which node)") && \
    NODE_ROOT=$(dirname "$NVM_BIN") && \
    rm -rf /opt/node && \
    cp -a "$NODE_ROOT" /opt/node && \
    chmod -R a+rX /opt/node && \
    ln -sf /opt/node/bin/node /usr/local/bin/node && \
    ln -sf /opt/node/bin/npm  /usr/local/bin/npm  && \
    ln -sf /opt/node/bin/npx  /usr/local/bin/npx

# pyenv — same ownership pattern: developer owns, chmod 755 lets agent read/execute but not write.
ENV PYENV_ROOT=/home/developer/.pyenv
ENV PATH=$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH
RUN git clone --depth=1 https://github.com/pyenv/pyenv.git $PYENV_ROOT && \
    cd $PYENV_ROOT && src/configure && make -C src && \
    chown -R developer:developer $PYENV_ROOT && \
    chmod -R 755 $PYENV_ROOT

# /workspace: owned by agent (999) with setgid so new files inherit group=access automatically.
# uid 999 can create/write; uid 1000 and uid 998 can read/enter via group=access.
RUN mkdir -p /workspace && \
    chown 999:1001 /workspace && \
    chmod 2775 /workspace

WORKDIR /workspace
