{
  "name": "workspace-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "next build",
    "lint": "next lint",
    "build-graph": "tsx dev_tools/viz/generate-graph.ts",
    "graph": "tsx dev_tools/viz/generate-graph.ts && open dev_tools/viz/graph.html",
    "query-graph": "tsx dev_tools/query/query-graph.ts",
    "update-pricing": "tsx scripts/update-pricing.ts",
    "check:mocks": "tsx scripts/check-mock-drift.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@langchain/anthropic": "^1.5.0",
    "@langchain/core": "^1.2.0",
    "@langchain/openai": "^1.5.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.20.0",
    "chokidar": "3.5.3",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "jszip": "^3.10.1",
    "next": "^16.2.9",
    "node-forge": "^1.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.3.1",
    "ts-morph": "^25.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
