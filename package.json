{
  "name": "workspace-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": "^11.6.2"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "start": "docker compose up --build",
    "stop": "docker compose down",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-graph": "tsx dev_tools/viz/generate-graph.ts",
    "graph": "tsx dev_tools/viz/generate-graph.ts && open dev_tools/viz/graph.html",
    "query-graph": "tsx dev_tools/query/query-graph.ts",
    "update-pricing": "tsx scripts/update-pricing.ts",
    "backup": "tsx scripts/backup-all.ts",
    "restore": "tsx scripts/backup-restore.ts",
    "backup:offsite": "bash scripts/backup-offsite.sh",
    "backup:schedule": "bash scripts/install-backup-schedule.sh",
    "check:mocks": "tsx scripts/check-mock-drift.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/lib-storage": "^3.1142.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.2.13",
    "@langchain/openai": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "5.0.0",
    "dotenv": "^18.0.4",
    "file-type": "^22.1.1",
    "jszip": "^3.10.2",
    "luxon": "^3.7.2",
    "next": "^16.3.7",
    "node-forge": "^1.4.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar-stream": "^3.2.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.1",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "better-sqlite3": false,
    "fsevents": false
  }
}
